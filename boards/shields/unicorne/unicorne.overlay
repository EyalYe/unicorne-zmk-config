/*
 * Unicorne: unibody 42-key choc Corne with a center Azoteq TPS43 trackpad.
 * Handwired to a nice!nano v2.
 *
 * Matrix: 6 rows x 7 cols, diodes col2row (cathode/stripe towards the row wire).
 * Only the nRF52840 "low frequency I/O only" pins are used for the matrix,
 * leaving the full-speed pins free for the trackpad I2C bus.
 *
 *   Left half              Right half
 *   rows 0-2               rows 3-5
 *   col 0..5 = outer->inner  col 0..5 = inner->outer
 *   col 6 = thumbs (row 0/3 = top thumb ... row 2/5 = steepest thumb)
 *
 *   ROW0 D21 P0.31   COL0 D16 P0.10
 *   ROW1 D20 P0.29   COL1 D10 P0.09
 *   ROW2 D19 P0.02   COL2 D8  P1.04
 *   ROW3 D18 P1.15   COL3 D9  P1.06
 *   ROW4 D15 P1.13   COL4 P1.01 (center pad)
 *   ROW5 D14 P1.11   COL5 P1.02 (center pad)
 *                    COL6 P1.07 (center pad)
 *
 *   TPS43: SDA D2 P0.17, SCL D3 P0.20, RDY D4 P0.22, RST D5 P0.24, VDD VCC, GND
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/* P0.09 / P0.10 default to NFC antenna pins; release them as GPIOs. */
&uicr {
    nfct-pins-as-gpios;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &unicorne_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio0 10 GPIO_ACTIVE_HIGH>
            , <&gpio0  9 GPIO_ACTIVE_HIGH>
            , <&gpio1  4 GPIO_ACTIVE_HIGH>
            , <&gpio1  6 GPIO_ACTIVE_HIGH>
            , <&gpio1  1 GPIO_ACTIVE_HIGH>
            , <&gpio1  2 GPIO_ACTIVE_HIGH>
            , <&gpio1  7 GPIO_ACTIVE_HIGH>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <6>;
        columns = <7>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5)
                        RC(0,6) RC(1,6) RC(2,6)   RC(3,6) RC(4,6) RC(5,6)
        >;
    };

    /* Key positions measured from cad/unicorne-choc-42-plate.step, 1u = 19 mm. */
    unicorne_layout: unicorne_layout {
        compatible = "zmk,physical-layout";
        display-name = "Unicorne";
        transform = <&default_transform>;
        keys  //                     w   h     x     y     rot    rx    ry
            = <&key_physical_attrs 100 100    55     0   1600   105    50>
            , <&key_physical_attrs 100 100   151    28   1600   201    78>
            , <&key_physical_attrs 100 100   254    31   1600   304    81>
            , <&key_physical_attrs 100 100   354    47   1600   404    97>
            , <&key_physical_attrs 100 100   447    86   1600   497   136>
            , <&key_physical_attrs 100 100   539   126   1600   589   176>
            , <&key_physical_attrs 100 100   865   126  (-1600)   915   176>
            , <&key_physical_attrs 100 100   958    86  (-1600)  1008   136>
            , <&key_physical_attrs 100 100  1051    47  (-1600)  1101    97>
            , <&key_physical_attrs 100 100  1150    31  (-1600)  1200    81>
            , <&key_physical_attrs 100 100  1253    28  (-1600)  1303    78>
            , <&key_physical_attrs 100 100  1349     0  (-1600)  1399    50>
            , <&key_physical_attrs 100 100    28    96   1600    78   146>
            , <&key_physical_attrs 100 100   124   124   1600   174   174>
            , <&key_physical_attrs 100 100   227   127   1600   277   177>
            , <&key_physical_attrs 100 100   326   143   1600   376   193>
            , <&key_physical_attrs 100 100   419   182   1600   469   232>
            , <&key_physical_attrs 100 100   512   222   1600   562   272>
            , <&key_physical_attrs 100 100   893   222  (-1600)   943   272>
            , <&key_physical_attrs 100 100   985   182  (-1600)  1035   232>
            , <&key_physical_attrs 100 100  1078   143  (-1600)  1128   193>
            , <&key_physical_attrs 100 100  1178   127  (-1600)  1228   177>
            , <&key_physical_attrs 100 100  1281   124  (-1600)  1331   174>
            , <&key_physical_attrs 100 100  1377    96  (-1600)  1427   146>
            , <&key_physical_attrs 100 100     0   192   1600    50   242>
            , <&key_physical_attrs 100 100    96   220   1600   146   270>
            , <&key_physical_attrs 100 100   199   223   1600   249   273>
            , <&key_physical_attrs 100 100   299   239   1600   349   289>
            , <&key_physical_attrs 100 100   391   278   1600   441   328>
            , <&key_physical_attrs 100 100   484   318   1600   534   368>
            , <&key_physical_attrs 100 100   920   318  (-1600)   970   368>
            , <&key_physical_attrs 100 100  1013   278  (-1600)  1063   328>
            , <&key_physical_attrs 100 100  1106   239  (-1600)  1156   289>
            , <&key_physical_attrs 100 100  1205   223  (-1600)  1255   273>
            , <&key_physical_attrs 100 100  1308   220  (-1600)  1358   270>
            , <&key_physical_attrs 100 100  1404   192  (-1600)  1454   242>
            , <&key_physical_attrs 100 100   315   364   1600   365   414>
            , <&key_physical_attrs 100 100   417   408   3100   467   458>
            , <&key_physical_attrs 100 100   524   460   4600   574   510>
            , <&key_physical_attrs 100 100   880   460  (-4600)   930   510>
            , <&key_physical_attrs 100 100   987   408  (-3100)  1037   458>
            , <&key_physical_attrs 100 100  1090   364  (-1600)  1140   414>
            ;
    };
};

/*
 * Optional nice!view (build with shield "unicorne nice_view").
 * SPI1 is used because SPI0 shares its peripheral with the trackpad's I2C0.
 *   SCK D0 P0.08, MOSI D6 P1.00, CS D1 P0.06, VCC VCC, GND GND
 */
&pinctrl {
    spi1_nice_view_default: spi1_nice_view_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 1, 0)>;
        };
    };
    spi1_nice_view_sleep: spi1_nice_view_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 1, 0)>;
            low-power-enable;
        };
    };
};

nice_view_spi: &spi1 {
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi1_nice_view_default>;
    pinctrl-1 = <&spi1_nice_view_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    clock-frequency = <I2C_BITRATE_FAST>;

    tps43: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        rdy-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;

        one-finger-tap;
        two-finger-tap;
        press-and-hold;
        press-and-hold-time = <250>;
        scroll;
        natural-scroll-y;

        bottom-beta = <5>;
        stationary-threshold = <5>;
    };
};
